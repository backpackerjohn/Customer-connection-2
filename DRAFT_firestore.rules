rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(data) {
      return isSignedIn() && data.get('createdBy', null) == request.auth.uid;
    }

    function isNoteAuthor(data) {
      return isSignedIn() && data.get('authorId', null) == request.auth.uid;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Customer Validation ---
    // BUDGET NOTE: Firestore evaluates at most 1000 expressions per rule. The
    // old `(!('x' in data) || (data.x is string && data.x.size() <= N))` form
    // cost ~13 expressions per populated field and a customer with ~40 filled
    // fields was denied outright. `data.get('x', '').size() <= N` costs ~7 and
    // is constant whether or not the field is present. Type safety comes from
    // the fact that .size() errors (= deny) on numbers, bools, timestamps and
    // null; a list or map would pass the length cap, which the 1 MB document
    // limit already bounds. Keep every line in this cheap form.
    function isValidCustomer(data) {
      return (data.get('status', 'lead') in ['lead', 'sold', 'inactive'])
        && (data.get('hasTradeIn', false) is bool)
        && (data.get('stillOwe', false) is bool)
        && (data.get('payingCash', false) is bool)
        && (data.get('working', false) is bool)

        // Personal info
        && data.get('firstName', '').size() <= 100
        && data.get('middleInitial', '').size() <= 10
        && data.get('lastName', '').size() <= 100
        && data.get('dob', '').size() <= 20
        && data.get('phone', '').size() <= 20
        && data.get('email', '').size() <= 200
        && data.get('address', '').size() <= 200
        && data.get('city', '').size() <= 100
        && data.get('state', '').size() <= 50
        && data.get('zip', '').size() <= 20

        // License + Vehicle
        && data.get('dlNumber', '').size() <= 50
        && data.get('dlState', '').size() <= 50
        && data.get('dlExpiration', '').size() <= 20
        && data.get('dlImageUrl', '').size() <= 1024
        && data.get('vehicleStock', '').size() <= 50
        && data.get('vehicleYear', '').size() <= 10
        && data.get('vehicleMake', '').size() <= 50
        && data.get('vehicleModel', '').size() <= 50
        && data.get('vehicleVin', '').size() <= 50
        && data.get('vehicleMiles', '').size() <= 20

        // Insurance + Trade
        && data.get('insuranceCompany', '').size() <= 100
        && data.get('insuranceImageUrl', '').size() <= 1024
        && data.get('agentName', '').size() <= 100
        && data.get('tradeYear', '').size() <= 10
        && data.get('tradeMake', '').size() <= 50
        && data.get('tradeModel', '').size() <= 50
        && data.get('tradeTrim', '').size() <= 50
        && data.get('tradeMileage', '').size() <= 20
        && data.get('tradeVin', '').size() <= 50

        // Finance + Goals
        && data.get('lienholder', '').size() <= 100
        && data.get('payoffAmount', '').size() <= 20
        && data.get('monthlyPayment', '').size() <= 20
        && data.get('monthsRemaining', '').size() <= 20
        && data.get('goalsMonthlyPayment', '').size() <= 50
        && data.get('goalsMoneyDown', '').size() <= 20
        && data.get('goalsCreditScore', '').size() <= 20
        && data.get('customerDesiredTradeValue', '').size() <= 20

        // Trade values (low/high + per-condition tiers + metadata)
        && data.get('tradeValueLow', '').size() <= 20
        && data.get('tradeValueHigh', '').size() <= 20
        && data.get('tradeValueExcellentLow', '').size() <= 20
        && data.get('tradeValueExcellentHigh', '').size() <= 20
        && data.get('tradeValueVeryGoodLow', '').size() <= 20
        && data.get('tradeValueVeryGoodHigh', '').size() <= 20
        && data.get('tradeValueGoodLow', '').size() <= 20
        && data.get('tradeValueGoodHigh', '').size() <= 20
        && data.get('tradeValueFairLow', '').size() <= 20
        && data.get('tradeValueFairHigh', '').size() <= 20
        && data.get('tradeValueSource', '').size() <= 100
        && data.get('tradeValueCondition', '').size() <= 20
        && data.get('tradeValueAt', '').size() <= 30

        // Reminders
        && data.get('lastContactedAt', '').size() <= 30
        && data.get('nextCadenceDue', '').size() <= 30
        && data.get('manualReminders', []) is list && data.get('manualReminders', []).size() <= 50
        && data.get('purchaseDate', '').size() <= 30
        && data.get('referralAskedAt', '').size() <= 30

        // Bulk Intake lead metadata
        && data.get('leadSource', '').size() <= 200
        && data.get('leadSourceType', '').size() <= 30
        && data.get('leadGeneratedDate', '').size() <= 20
        && data.get('pendingInterestNotes', '').size() <= 500

        // Communication channel
        && data.get('contactChannel', '').size() <= 30

        // Trade check-in (Buyers Guide / Check-In Sheet packet)
        && data.get('tradeIsBLine', false) is bool
        && data.get('tradeStockNumber', '').size() <= 20
        && data.get('tradeCheckIn', {}) is map
        && data.get('tradeCheckIn', {}).size() <= 12
        && data.get('tradeCheckIn', {}).get('equipment', []) is list
        && data.get('tradeCheckIn', {}).get('equipment', []).size() <= 150
        && data.get('tradeCheckIn', {}).get('unsure', []) is list
        && data.get('tradeCheckIn', {}).get('unsure', []).size() <= 150;
    }

    function isValidNote(data) {
      return data.get('content', '') is string && data.get('content', '').size() <= 5000
        && data.get('type', '') in ['manual', 'ai', 'transcript']
        && data.get('authorId', null) == request.auth.uid;
    }

    function isValidContact(data) {
      let note = data.get('note', '');
      let attestedAt = data.get('attestedAt', '');
      return data.get('authorId', null) == request.auth.uid
        && data.get('kinds', []) is list
        && data.get('kinds', []).size() <= 10
        && note is string
        && note.size() <= 1000
        && attestedAt is string
        && attestedAt.size() <= 30;
    }

    function isValidTodo(data) {
      return data.get('createdBy', null) == request.auth.uid
        && data.get('text', '') is string && data.get('text', '').size() <= 2000
        && data.get('done', false) is bool
        && (!('customerId' in data) || (data.customerId is string && data.customerId.size() <= 128))
        && (!('customerName' in data) || (data.customerName is string && data.customerName.size() <= 200))
        && (data.get('completedAt', null) == null || data.completedAt is timestamp);
    }

    // --- Collection Routes ---
    match /customers/{customerId} {
      allow get: if isValidId(customerId) && isOwner(existing());
      allow list: if isSignedIn() && resource.data.get('createdBy', null) == request.auth.uid;
      
      allow create: if isSignedIn() 
        && isValidId(customerId)
        && isValidCustomer(incoming())
        && incoming().keys().hasOnly([
          'firstName', 'middleInitial', 'lastName', 'dob', 'phone', 'email', 'address', 'city', 'state', 'zip',
          'dlNumber', 'dlState', 'dlExpiration', 'dlImageUrl', 'vehicleStock', 'vehicleYear', 'vehicleMake',
          'vehicleModel', 'vehicleVin', 'vehicleMiles', 'insuranceCompany', 'insuranceImageUrl', 'agentName',
          'hasTradeIn', 'stillOwe', 'payingCash', 'tradeYear', 'tradeMake', 'tradeModel', 'tradeTrim', 'tradeMileage',
          'tradeVin', 'lienholder', 'payoffAmount', 'monthlyPayment',
          'monthsRemaining', 'goalsMonthlyPayment', 'goalsMoneyDown', 'goalsCreditScore',
          'tradeValueLow', 'tradeValueHigh',
          'tradeValueExcellentLow', 'tradeValueExcellentHigh',
          'tradeValueVeryGoodLow', 'tradeValueVeryGoodHigh',
          'tradeValueGoodLow', 'tradeValueGoodHigh',
          'tradeValueFairLow', 'tradeValueFairHigh',
          'tradeValueSource', 'tradeValueCondition',
          'tradeValueAt', 'customerDesiredTradeValue', 'status', 'updatedAt',
          'createdBy', 'createdAt', 'lastContactedAt', 'nextCadenceDue', 'manualReminders', 'purchaseDate', 'referralAskedAt',
          'leadSource', 'leadSourceType', 'leadGeneratedDate', 'pendingInterestNotes', 'contactChannel', 'working',
          'tradeIsBLine', 'tradeStockNumber', 'tradeCheckIn'
        ])
        && incoming().createdAt == request.time
        && (incoming().updatedAt == request.time || !('updatedAt' in incoming()))
        && (incoming().createdBy == request.auth.uid);
        
      allow update: if isSignedIn()
        && isValidId(customerId)
        && (isOwner(existing()) || existing().get('createdBy', null) == null) // Handle legacy docs without createdBy
        && isValidCustomer(incoming())
        // Immutable check
        && (incoming().get('createdAt', existing().get('createdAt', null)) == existing().get('createdAt', null))
        && (incoming().get('createdBy', existing().get('createdBy', null)) == existing().get('createdBy', null))
        // Action-Based Pattern
        && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'firstName', 'middleInitial', 'lastName', 'dob', 'phone', 'email', 'address', 'city', 'state', 'zip',
            'dlNumber', 'dlState', 'dlExpiration', 'dlImageUrl', 'vehicleStock', 'vehicleYear', 'vehicleMake',
            'vehicleModel', 'vehicleVin', 'vehicleMiles', 'insuranceCompany', 'insuranceImageUrl', 'agentName',
            'hasTradeIn', 'stillOwe', 'payingCash', 'tradeYear', 'tradeMake', 'tradeModel', 'tradeTrim', 'tradeMileage',
            'tradeVin', 'lienholder', 'payoffAmount', 'monthlyPayment',
            'monthsRemaining', 'goalsMonthlyPayment', 'goalsMoneyDown', 'goalsCreditScore',
            'tradeValueLow', 'tradeValueHigh',
            'tradeValueExcellentLow', 'tradeValueExcellentHigh',
            'tradeValueVeryGoodLow', 'tradeValueVeryGoodHigh',
            'tradeValueGoodLow', 'tradeValueGoodHigh',
            'tradeValueFairLow', 'tradeValueFairHigh',
            'tradeValueSource', 'tradeValueCondition',
            'tradeValueAt', 'customerDesiredTradeValue', 'status', 'updatedAt',
            'createdBy', 'createdAt', 'lastContactedAt', 'nextCadenceDue', 'manualReminders', 'purchaseDate', 'referralAskedAt',
            'leadSource', 'leadSourceType', 'leadGeneratedDate', 'pendingInterestNotes', 'contactChannel', 'working',
            'tradeIsBLine', 'tradeStockNumber', 'tradeCheckIn'
          ])
        )
        && (incoming().get('updatedAt', request.time) == request.time);

      allow delete: if isValidId(customerId) && isOwner(existing());

      // Notes Subcollection
      match /notes/{noteId} {
        allow list: if isSignedIn() && resource.data.get('authorId', null) == request.auth.uid;
        allow get: if isValidId(noteId) && isNoteAuthor(resource.data);
        allow create: if isValidId(noteId) 
          && isValidNote(incoming())
          && get(/databases/$(database)/documents/customers/$(customerId)).data.get('createdBy', null) == request.auth.uid
          && incoming().createdAt == request.time;
        allow update, delete: if isValidId(noteId) && isNoteAuthor(existing());
      }

      // Contacts Subcollection
      match /contacts/{contactId} {
        allow list: if isSignedIn() && resource.data.get('authorId', null) == request.auth.uid;
        allow get: if isValidId(contactId) && isSignedIn() && resource.data.get('authorId', null) == request.auth.uid;
        allow create: if isValidId(contactId)
          && isValidContact(incoming())
          && get(/databases/$(database)/documents/customers/$(customerId)).data.get('createdBy', null) == request.auth.uid
          && incoming().at == request.time;
        allow update, delete: if isValidId(contactId) && isSignedIn() && existing().get('authorId', null) == request.auth.uid;
      }
    }

    match /todos/{todoId} {
      allow get: if isValidId(todoId) && isOwner(existing());
      allow list: if isSignedIn() && resource.data.get('createdBy', null) == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(todoId)
        && isValidTodo(incoming())
        && incoming().get('createdBy', null) == request.auth.uid
        && incoming().keys().hasOnly(['text', 'done', 'customerId', 'customerName', 'createdBy', 'createdAt', 'completedAt'])
        && incoming().get('createdAt', request.time) == request.time;
      allow update: if isValidId(todoId)
        && isOwner(existing())
        && isOwner(incoming())
        && isValidTodo(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['text', 'done', 'completedAt']);
      allow delete: if isValidId(todoId) && isOwner(existing());
    }

    match /{path=**}/notes/{noteId} {
      allow list: if isSignedIn() && resource.data.get('authorId', null) == request.auth.uid;
    }
  }
}
